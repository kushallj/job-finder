# =============================================================================
# 🚀 JOB-FINDER & THE GODFATHER CONSIGLIERE — ENVIRONMENT CONFIGURATION
# =============================================================================
# Copy this file to `.env` and fill in the values for your setup:
#   cp .env.example .env
#
# Minimum required for local development:
#   - SQLite and in-memory mock providers run out of the box with zero keys!
#   - Add TELEGRAM_BOT_TOKEN to activate live Telegram Bot controls.
#   - Add GEMINI_API_KEY or run local Ollama for AI generation.
# =============================================================================


# =============================================================================
# 1. 🌐 SERVER & APPLICATION RUNTIME
# =============================================================================
ENV=development                 # development | production | test
LOG_LEVEL=INFO                  # DEBUG | INFO | WARNING | ERROR
HOST=0.0.0.0
PORT=8000
DATABASE_URL=sqlite:///./jobs.db
# For PostgreSQL (production):
# DATABASE_URL=postgresql://user:password@localhost:5432/job_finder_db
# For Supabase:
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_KEY=your-supabase-anon-or-service-key

# Redis (Caching & Job Queue)
REDIS_URL=redis://localhost:6379/0


# =============================================================================
# 2. 👑 THE GODFATHER TELEGRAM BOT & 24x7 RADAR
# =============================================================================
# Obtain bot token from @BotFather on Telegram (e.g. 123456789:ABCdefGHIjklMNO)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
AUTOPILOT_ENABLED=true


# =============================================================================
# 3. 🧠 UNIFIED AI & LLM ENGINE (CASCADE FALLBACK)
# =============================================================================
# Primary 1: Local Ollama (Free, private, zero API cost)
# Start ollama with: ollama run qwen2.5-coder:7b
OLLAMA_MODEL=qwen2.5-coder:7b
OLLAMA_KEEP_ALIVE=5m

# Fallback 1: Google Gemini API (Free tier available: https://aistudio.google.com/)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Additional LLMs (Optional)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=


# =============================================================================
# 4. 🕷️ COMMON CRAWL S3 STEALTH MINER & SEARCH ENGINES
# =============================================================================
# Petabyte Common Crawl S3 Byte-Range Miner (100% Free & Zero Target Touch)
COMMON_CRAWL_DEFAULT_INDEX=CC-MAIN-2024-51

# Firecrawl — Direct career page crawling (https://www.firecrawl.dev/)
FIRECRAWL_API_KEY=

# Search APIs for Dorking & Boolean X-Ray Lead Generation (Configure at least one)
SERPAPI_API_KEY=
GOOGLE_SEARCH_API_KEY=
GOOGLE_CSE_ID=
SERPER_API_KEY=

# LinkedIn Profile Scraper
PROXYCURL_API_KEY=


# =============================================================================
# 5. 🎯 EMAIL INTELLIGENCE & DISCOVERY PROVIDERS
# =============================================================================
# Free / Zero-Key Providers (Active by Default):
# - Common Crawl S3 Byte-Range Miner
# - crt.sh Certificate Transparency Logs
# - GitHub Developer Commit Miner

# GitHub Token (Increases rate limit from 60 to 5,000 req/hr)
GITHUB_TOKEN=

# Commercial Email Discovery APIs (Optional — Add keys as available)
HUNTER_API_KEY=
APOLLO_API_KEY=
CLEARBIT_API_KEY=
ROCKETREACH_API_KEY=
SNOV_CLIENT_ID=
SNOV_CLIENT_SECRET=
SKRAPP_SECRET_KEY=
ANYMAIL_FINDER_API_KEY=
VOILA_NORBERT_API_KEY=
DROPCONTACT_API_KEY=
KASPR_API_KEY=
SIGNALHIRE_API_KEY=
SIGNALHIRE_CALLBACK_URL=


# =============================================================================
# 6. 📧 EMAIL OUTREACH & DISPATCH GATEWAY
# =============================================================================
# Outreach provider: "smtp" | "sendgrid" | "ses"
EMAIL_PROVIDER=smtp
AUTO_SEND_EMAILS=false          # Set to true for automated dispatch; false for review gate

# Gmail SMTP / IMAP Settings (Recommended: Use Google App Password)
GMAIL_ADDRESS=your.email@gmail.com
GMAIL_PASSWORD=your-16-char-app-password
GOOGLE_CREDENTIALS_PATH=config/google-service-account.json

# SendGrid (Optional)
SENDGRID_API_KEY=

# AWS SES (Optional)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_SES_SOURCE_ARN=


# =============================================================================
# 7. 👤 SENDER IDENTITY & CANDIDATE PROFILE
# =============================================================================
SENDER_NAME=Your Full Name
LINKEDIN_URL=https://linkedin.com/in/yourprofile
TAGLINE=Staff Distributed Systems & AI Engineer

# Tsenta Autonomous Auto-Apply Agent (YC S26)
TSENTA_API_KEY=
TSENTA_API_URL=https://api.tsenta.com/v1
TSENTA_MODE=review_required     # "review_required" | "full_auto"
TSENTA_AUTO_SUBMIT=false
TSENTA_MIN_FIT_SCORE=75


# =============================================================================
# 8. 📊 GOOGLE SHEETS & EXTERNAL JOB AGGREGATORS (OPTIONAL)
# =============================================================================
GOOGLE_SHEET_TITLE=Job Applications Tracker
GOOGLE_SHEET_ID=
GOOGLE_SHEET_WORKSHEET=Sheet1

ADZUNA_APP_ID=
ADZUNA_APP_KEY=
JOBDATA_API_KEY=
CAREERJET_API_KEY=
CAREERJET_LOCALE_CODE=en_US
USAJOBS_API_KEY=
USAJOBS_EMAIL=


# =============================================================================
# 9. 🔔 WEBHOOK ALERTS (OPTIONAL)
# =============================================================================
DISCORD_WEBHOOK_URL=
SLACK_WEBHOOK_URL=
