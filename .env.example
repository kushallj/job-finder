# =============================================================================
# 🚀 JOB-FINDER & THE GODFATHER CONSIGLIERE — ENVIRONMENT CONFIGURATION
# =============================================================================
# Copy this file to `.env` and fill in the values for your setup:
#   cp .env.example .env
#
# Minimum required for local development:
#   - SQLite and in-memory mock providers run out of the box with zero keys!
#   - Add TELEGRAM_BOT_TOKEN to activate live Telegram Bot controls.
#   - Add GEMINI_API_KEY or run local Ollama for AI generation.
# =============================================================================


# =============================================================================
# 1. 🌐 SERVER & APPLICATION RUNTIME
# =============================================================================
ENV=development                 # development | production | test
LOG_LEVEL=INFO                  # DEBUG | INFO | WARNING | ERROR
HOST=0.0.0.0
PORT=8000
DATABASE_URL=sqlite:///./jobs.db
# For PostgreSQL (production):
# DATABASE_URL=postgresql://user:password@localhost:5432/job_finder_db
# For Supabase:
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_KEY=your-supabase-anon-or-service-key

# Redis (Caching & Job Queue)
REDIS_URL=redis://localhost:6379/0


# =============================================================================
# 2. 👑 THE GODFATHER TELEGRAM BOT & 24x7 RADAR
# =============================================================================
# Obtain bot token from @BotFather on Telegram (e.g. 123456789:ABCdefGHIjklMNO)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
AUTOPILOT_ENABLED=true


# =============================================================================
# 3. 🧠 UNIFIED AI & LLM ENGINE (CASCADE FALLBACK)
# =============================================================================
# Primary 1: Local Ollama (Free, private, zero API cost)
# Start ollama with: ollama run qwen2.5-coder:7b
OLLAMA_MODEL=qwen2.5-coder:7b
OLLAMA_KEEP_ALIVE=5m

# Fallback 1: Google Gemini API (Free tier available: https://aistudio.google.com/)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Additional LLMs (Optional)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=


# =============================================================================
# 4. 🕷️ COMMON CRAWL S3 STEALTH MINER & SEARCH ENGINES
# =============================================================================
# Petabyte Common Crawl S3 Byte-Range Miner (100% Free & Zero Target Touch)
COMMON_CRAWL_DEFAULT_INDEX=CC-MAIN-2024-51

# Firecrawl — Direct career page crawling (https://www.firecrawl.dev/)
FIRECRAWL_API_KEY=

# Search APIs for Dorking & Boolean X-Ray Lead Generation (Configure at least one)
SERPAPI_API_KEY=
GOOGLE_SEARCH_API_KEY=
GOOGLE_CSE_ID=
SERPER_API_KEY=

# LinkedIn Profile Scraper
PROXYCURL_API_KEY=


# =============================================================================
# 5. 🎯 EMAIL INTELLIGENCE & DISCOVERY PROVIDERS
# =============================================================================
# Free / Zero-Key Providers (Active by Default):
# - Common Crawl S3 Byte-Range Miner
# - crt.sh Certificate Transparency Logs
# - GitHub Developer Commit Miner

# GitHub Token (Increases rate limit from 60 to 5,000 req/hr)
GITHUB_TOKEN=

# Commercial Email Discovery APIs (Optional — Add keys as available)
HUNTER_API_KEY=
APOLLO_API_KEY=
CLEARBIT_API_KEY=
ROCKETREACH_API_KEY=
SNOV_CLIENT_ID=
SNOV_CLIENT_SECRET=
SKRAPP_SECRET_KEY=
ANYMAIL_FINDER_API_KEY=
VOILA_NORBERT_API_KEY=
DROPCONTACT_API_KEY=
KASPR_API_KEY=
SIGNALHIRE_API_KEY=
SIGNALHIRE_CALLBACK_URL=


# =============================================================================
# 6. 📧 EMAIL OUTREACH & DISPATCH GATEWAY
# =============================================================================
# Outreach provider: "smtp" | "sendgrid" | "ses"
EMAIL_PROVIDER=smtp
AUTO_SEND_EMAILS=false          # Set to true for automated dispatch; false for review gate
# Jobify job catalog refresh (Celery beat). Hours are UTC; default 08:00 + 20:00 IST.
CATALOG_REFRESH_HOURS_UTC=2,14
CATALOG_REFRESH_MINUTE=30
# Comma-separated job-board searches; empty = defaults in src/tasks.py
CATALOG_QUERIES=
# GET /api/admin/catalog-runs reports stale after this many hours without a successful run
CATALOG_STALE_AFTER_HOURS=26

# Gmail SMTP / IMAP Settings (Recommended: Use Google App Password)
GMAIL_ADDRESS=your.email@gmail.com
GMAIL_PASSWORD=your-16-char-app-password
GOOGLE_CREDENTIALS_PATH=config/google-service-account.json

# SendGrid (Optional)
SENDGRID_API_KEY=

# AWS SES (Optional)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_SES_SOURCE_ARN=


# =============================================================================
# 7. 👤 SENDER IDENTITY & CANDIDATE PROFILE
# =============================================================================
SENDER_NAME=Your Full Name
LINKEDIN_URL=https://linkedin.com/in/yourprofile
TAGLINE=Staff Distributed Systems & AI Engineer

# Tsenta Autonomous Auto-Apply Agent (YC S26)
TSENTA_API_KEY=
TSENTA_API_URL=https://api.tsenta.com/v1
TSENTA_MODE=review_required     # "review_required" | "full_auto"
TSENTA_AUTO_SUBMIT=false
TSENTA_MIN_FIT_SCORE=75


# =============================================================================
# 8. 📊 GOOGLE SHEETS & EXTERNAL JOB AGGREGATORS (OPTIONAL)
# =============================================================================
GOOGLE_SHEET_TITLE=Job Applications Tracker
GOOGLE_SHEET_ID=
GOOGLE_SHEET_WORKSHEET=Sheet1

ADZUNA_APP_ID=
ADZUNA_APP_KEY=
JOBDATA_API_KEY=
CAREERJET_API_KEY=
CAREERJET_LOCALE_CODE=en_US
USAJOBS_API_KEY=
USAJOBS_EMAIL=


# =============================================================================
# 9. 🔔 WEBHOOK ALERTS (OPTIONAL)
# =============================================================================
DISCORD_WEBHOOK_URL=
SLACK_WEBHOOK_URL=

# --- Auth (Clerk) --- server-side; must match the Clerk instance Jobify uses
CLERK_ISSUER=
# CLERK_JWKS_URL defaults to $CLERK_ISSUER/.well-known/jwks.json
CLERK_JWKS_URL=
# Comma-separated frontend origins accepted in the token azp claim
CLERK_AUTHORIZED_PARTIES=http://localhost:3000
CLERK_WEBHOOK_SECRET=
CLERK_SECRET_KEY=
MULTI_TENANT_ENABLED=true
ALLOW_DEV_AUTH_TOKENS=false
CORS_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# --- Payments (Dodo) ---
BILLING_PROVIDER=dodo
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_WEBHOOK_SECRET=
DODO_PAYMENTS_ENVIRONMENT=test_mode

# --- Gmail OAuth (gmail.readonly) ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/gmail/callback
# Fernet key for encrypting OAuth refresh tokens at rest
TOKEN_ENCRYPTION_KEY=

# Jobify chat (src/services/chat_providers.py). Comma-separated fallback chain, tried in order
# until one starts replying: echo (no-network stub) | ollama | openrouter | hf | custom.
# Dev: CHAT_PROVIDER=ollama   Production example: CHAT_PROVIDER=openrouter,hf
CHAT_PROVIDER=echo
CHAT_ECHO_DELAY_MS=40
CHAT_MAX_TOKENS=1024
# Let thinking models reason (hidden from users). Off: fast but weaker at maths and at refusing fake
# claims (scripts/chat_eval.py). On: recommended for hosted GPU providers; slow on CPU-only Ollama.
CHAT_REASONING=false
CHAT_REASONING_MAX_TOKENS=4096
# Per-user send limits (free tiers are per account, shared by all users)
CHAT_RATE_PER_MINUTE=6
CHAT_RATE_PER_DAY=150
CHAT_TEMPERATURE=0.4
CHAT_TIMEOUT_S=60
CHAT_OLLAMA_BASE_URL=http://localhost:11434/v1
CHAT_OLLAMA_MODEL=qwen3:8b
OPENROUTER_API_KEY=
# A model id from openrouter.ai/models (":free" ids are rate-limited and rotate)
CHAT_OPENROUTER_MODEL=
HF_TOKEN=
CHAT_HF_MODEL=
# Any other OpenAI-compatible API: Alibaba Qwen (dashscope-intl .../compatible-mode/v1),
# Moonshot Kimi (https://api.moonshot.ai/v1), MiniMax, NVIDIA NIM
CHAT_CUSTOM_BASE_URL=
CHAT_CUSTOM_API_KEY=
CHAT_CUSTOM_MODEL=
