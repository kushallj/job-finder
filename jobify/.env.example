# Copy to .env.local for development. Only VITE_* variables reach the browser,
# so NEVER put a secret in a VITE_* variable. Server secrets live in the backend.

# --- Auth (Clerk) --- publishable key is public by design
VITE_CLERK_PUBLISHABLE_KEY=

# --- Backend API --- base URL of the FastAPI service (no trailing slash).
# Leave empty to run on local mock services (src/mocks).
VITE_API_BASE_URL=

# --- Misc ---
VITE_NEWSLETTER_ENDPOINT=
VITE_SUPPORT_EMAIL=support@jobify.example
