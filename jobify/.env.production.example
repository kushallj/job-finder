# Copy to jobify/.env.production on the VM (git-ignored). Vite bakes these into the bundle at
# build time (infra/gcp/deploy.sh), so a change needs a redeploy. Never put secrets here.
VITE_CLERK_PUBLISHABLE_KEY=pk_live_...
VITE_API_BASE_URL=https://app.example.com/api
VITE_NEWSLETTER_ENDPOINT=
VITE_SUPPORT_EMAIL=support@example.com
