# =============================================================================
# 🚀 SYNOLOGY DSM CONTAINER MANAGER - ENVIRONMENT CONFIGURATION (.env)
# Project: kj_job_finder (/docker/kj_job_finder/x_deployment)
# =============================================================================

# -----------------------------------------------------------------------------
# 1. 🌐 SERVER RUNTIME & PORTS
# -----------------------------------------------------------------------------
ENV=production
LOG_LEVEL=INFO
PORT=8000

# Frontend API base URL (baked into the Vite bundle at Docker build time)
VITE_API_BASE_URL=https://testarea.ddns.net

# Host Port Mappings on Synology NAS
FRONTEND_PORT=3001
POSTGRES_PORT=5434
REDIS_PORT=6379
API_PORT=8001
FLOWER_PORT=5555

# -----------------------------------------------------------------------------
# 2. 🗄️ DATABASE & BROKER SETTINGS
# -----------------------------------------------------------------------------
POSTGRES_DB=job_finder_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# -----------------------------------------------------------------------------
# 3. 👑 THE GODFATHER TELEGRAM BOT & 24x7 RADAR (OPTIONAL)
# -----------------------------------------------------------------------------
# Obtain bot token from @BotFather on Telegram (e.g. 123456789:ABCdefGHIjklMNO)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
AUTOPILOT_ENABLED=true

# -----------------------------------------------------------------------------
# 4. 🧠 AI & LLM ENGINE (OPTIONAL)
# -----------------------------------------------------------------------------
# Google Gemini API (Free tier: https://aistudio.google.com/)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# OpenAI / Anthropic / Groq (Optional)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=

# -----------------------------------------------------------------------------
# 5. 🎯 EMAIL INTELLIGENCE & DISCOVERY (OPTIONAL)
# -----------------------------------------------------------------------------
# Commercial Discovery APIs (Hunter.io, Apollo, etc.)
HUNTER_API_KEY=
APOLLO_API_KEY=
SIGNALHIRE_API_KEY=
GITHUB_TOKEN=

# -----------------------------------------------------------------------------
# 6. 📧 EMAIL OUTREACH & DISPATCH (OPTIONAL)
# -----------------------------------------------------------------------------
EMAIL_PROVIDER=smtp
AUTO_SEND_EMAILS=false

# Gmail SMTP Settings (Use Google 16-character App Password)
GMAIL_ADDRESS=
GMAIL_PASSWORD=

# Sender Profile
SENDER_NAME=Your Full Name
LINKEDIN_URL=https://linkedin.com/in/yourprofile
TAGLINE=Staff Software Engineer

# -----------------------------------------------------------------------------
# 7. 🕷️ JOB SEARCH & SCRAPING PROVIDERS (OPTIONAL)
# -----------------------------------------------------------------------------
SERPAPI_API_KEY=
FIRECRAWL_API_KEY=
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_ID=
SERPER_API_KEY=
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
