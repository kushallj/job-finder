# ==============================================================================
# Job Finder Production SaaS Environment Configuration Template
# Copy this file to .env.production and populate real production values.
# ==============================================================================

# ── General Application Settings ──────────────────────────────────────────────
ENV=production
LOG_LEVEL=INFO
PORT=8000
FRONTEND_URL=https://your-domain.com

# ── Multi-Tenant SaaS Security & Authentication ───────────────────────────────
MULTI_TENANT_ENABLED=true
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=replace_with_a_64_character_random_hex_string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=10080
DEFAULT_SIGNUP_CREDITS=50

# ── Production Database (Supabase / Neon / Render / Local Postgres) ───────────
# Standard PostgreSQL URL format:
# Supabase: postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres?sslmode=require
# Neon: postgresql://[USER]:[PASSWORD]@[ENDPOINT].us-east-1.aws.neon.tech/[DBNAME]?sslmode=require
# Render: postgresql://[USER]:[PASSWORD]@[HOST]/[DBNAME]
DATABASE_URL=postgresql://jf_admin:your_secure_db_password@localhost:5432/job_finder_production

# Optional Supabase credentials for file storage / auth integration
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your_supabase_anon_or_service_role_key

# ── Redis (Caching & Task Broker) ─────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Platform Root AI Gateway (Centralized credentials for all tenants) ────────
# Google Gemini API key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaSy...
GEMINI_MODEL=gemini-2.0-flash

# ── Stripe Monetization & Webhooks ────────────────────────────────────────────
# Get keys from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_live_...
# Get webhook secret from: https://dashboard.stripe.com/webhooks
STRIPE_WEBHOOK_SECRET=whsec_...
# Stripe Product Price IDs (configured in Stripe dashboard):
STRIPE_PRICE_STARTER=price_starter_...
STRIPE_PRICE_PRO=price_pro_...
STRIPE_PRICE_UNLIMITED=price_unlimited_...
STRIPE_PRICE_PACK_100=price_pack_100_...
STRIPE_PRICE_PACK_300=price_pack_300_...

# ── External Sourcing & Email Discovery (Optional) ───────────────────────────
HUNTER_API_KEY=
APOLLO_API_KEY=
FIRECRAWL_API_KEY=
