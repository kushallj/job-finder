# ==============================================================================
# Production environment template. Set these in the platform's secret store
# (Render env groups / `fly secrets set`), never in a committed file.
# The API refuses to start if a required value is missing or unsafe
# (src/production_checks.py prints exactly which one).
# ==============================================================================

# ── Runtime ───────────────────────────────────────────────────────────────────
ENV=production
LOG_LEVEL=INFO
WEB_CONCURRENCY=2                     # uvicorn workers per container
FRONTEND_URL=https://app.your-domain.com
# Exact Jobify origin(s), https only. No localhost in production.
CORS_ORIGINS=https://app.your-domain.com
# Optional Host-header allow-list (recommended): the API's own hostname(s).
ALLOWED_HOSTS=api.your-domain.com
ENABLE_API_DOCS=false                 # /docs and /openapi.json stay off in production
MAX_REQUEST_BYTES=2000000

# ── Auth: Clerk (production instance on your own domain) ──────────────────────
MULTI_TENANT_ENABLED=true             # never false in production
ALLOW_DEV_AUTH_TOKENS=false
SEED_DEV_ADMIN=false
LEGACY_PASSWORD_AUTH_ENABLED=false    # Clerk is the only customer login
LEGACY_ROUTES_ENABLED=false           # legacy main.py routes stay admin-only
CLERK_ISSUER=https://clerk.your-domain.com
CLERK_JWKS_URL=                       # optional; derived from CLERK_ISSUER when empty
CLERK_AUTHORIZED_PARTIES=https://app.your-domain.com
CLERK_WEBHOOK_SECRET=whsec_...
# Legacy HS256 signer (still required to be non-default). python -c "import secrets;print(secrets.token_hex(32))"
JWT_SECRET_KEY=
DEFAULT_SIGNUP_CREDITS=50

# ── Data ──────────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require
REDIS_URL=rediss://default:PASSWORD@HOST:6379
# Encrypts stored OAuth refresh tokens. python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# ── Payments: Dodo (merchant of record) ───────────────────────────────────────
BILLING_PROVIDER=dodo                 # mock is refused in production
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_WEBHOOK_SECRET=whsec_...  # required: unsigned payment webhooks are rejected
DODO_PAYMENTS_ENVIRONMENT=live_mode
# Only if BILLING_PROVIDER=stripe:
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Jobify inbox (Cloudflare Email Routing → infra/cloudflare/inbox-worker) ───
INBOX_DOMAIN=mail.your-domain.com
INBOUND_WEBHOOK_SECRET=               # required when INBOX_DOMAIN is set
INBOX_SMTP_HOST=
INBOX_SMTP_PORT=587
INBOX_SMTP_USERNAME=
INBOX_SMTP_PASSWORD=

# ── Gmail sync (optional; needs Google OAuth verification for >100 users) ─────
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# ── Observability ─────────────────────────────────────────────────────────────
SENTRY_DSN=                           # error tracking (send_default_pii is off)
SENTRY_TRACES_SAMPLE_RATE=0.05

# ── Chat LLM (provider decision pending; see CLAUDE.md section 7) ─────────────
CHAT_PROVIDER=echo
GEMINI_API_KEY=

# ── Job sources (src/job_sources; `python -m src.job_sources --list`) ─────────
JOB_SOURCES=
JOB_SOURCES_ALLOW_SCRAPING=false      # scrape tier needs legal review first
CATALOG_QUERIES=
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=in
REED_API_KEY=
JOOBLE_API_KEY=
FINDWORK_API_KEY=
USAJOBS_API_KEY=
USAJOBS_EMAIL=
THEIRSTACK_API_KEY=
THEIRSTACK_MAX_RESULTS=25

# Never enable: no scheduled task may send email (CLAUDE.md section 1).
AUTO_SEND_EMAILS=false
